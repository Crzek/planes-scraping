#flask
FLASK_APP=main:app
FLASK_ENV=production
SECRET_KEY="key"

# entrypoint bluprint
CONFIG_ENV=${FLASK_ENV}
DEBUG=False

# chrome
PATH_BROWSER="/usr/bin/google-chrome"
PATH_DRIVER="/usr/local/bin/chromedriver"

# postgres (SQLAlchemy URI is built from these parts)
DATABASE_USER=user
DATABASE_PASS=pass
DATABASE_HOST=host
DATABASE_PORT=5432
DATABASE_NAME=database


# escrapy
user=user
password=pass
base_url=https://acbs.private-radar.com/

# API de private-radar (opcional; USE_API_FIRST=false mantiene solo Playwright)
USE_API_FIRST=false
API_LOGIN_URL=https://api4.private-radar.com/auth/user/login
API_BOOKINGS_URL=https://acbs.private-radar.com/prwsw/bookings/getByFilterNew
API_TIMEOUT=15
# Ruta local (descargar el certificado, ver Readme). En Docker la fija docker-compose.yml
API_EXTRA_CA_FILE=certs/sectigo-dv-r36.pem
USE_API_FIRST=true